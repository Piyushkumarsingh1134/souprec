// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}




model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String
  role         Role     @default(GUEST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms        Room[]          @relation("UserRooms")
  participants Participant[]
  chunks       Chunk[]         // user’s uploaded chunks
}

model Room {
  id          String   @id @default(uuid())
  roomCode    String   @unique @db.VarChar(50)
  title       String?  @db.VarChar(200)
  description String?
  isLive      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  host   User   @relation("UserRooms", fields: [hostId], references: [id])
  hostId String

  participants Participant[]
  recordings   Recording[]
}

model Participant {
  id        String   @id @default(uuid())
  role      RoomRole @default(GUEST)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  // Relations
  user   User @relation(fields: [userId], references: [id])
  userId String

  room   Room @relation(fields: [roomId], references: [id])
  roomId String
}

model Recording {
  id         String   @id @default(uuid())
  storageUrl String
  duration   Int?
  createdAt  DateTime @default(now())

  // Relations
  room   Room   @relation(fields: [roomId], references: [id])
  roomId String

  chunks Chunk[]  // recording is built from chunks
}

model Chunk {
  id        String   @id @default(uuid())
  index     Int      // chunk number (0,1,2,...)
  storageUrl String  // temporary storage location (S3, Cloudinary, local FS)
  createdAt DateTime @default(now())

  // Relations
  user       User       @relation(fields: [userId], references: [id])
  userId     String

  recording  Recording? @relation(fields: [recordingId], references: [id])
  recordingId String?
}

enum Role {
  HOST
  GUEST
}

enum RoomRole {
  HOST
  GUEST
  COHOST
}



